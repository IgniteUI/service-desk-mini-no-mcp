@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="app-layout">
    <IgbNavbar>
        <IgbIconButton slot="start" Variant="IconButtonVariant.Flat" @onclick="ToggleNav">
            <IgbIcon name="menu" collection="material"></IgbIcon>
        </IgbIconButton>
        <div slot="start" class="app-brand">
            <span class="brand-icon">🎫</span>
            <span class="brand-name">Service Desk Mini</span>
        </div>
    </IgbNavbar>

    <div class="layout-body">
        <IgbNavDrawer Open="@_navOpen" Position="NavDrawerPosition.Start">
            <IgbNavDrawerHeaderItem>
                <div class="nav-header-content">
                    <IgbIcon name="support_agent" collection="material"></IgbIcon>
                    <span>Navigation</span>
                </div>
            </IgbNavDrawerHeaderItem>

            <IgbNavDrawerItem Active="@IsRoute("/")" @onclick="@(() => GoTo("/"))">
                <IgbIcon slot="icon" name="dashboard" collection="material"></IgbIcon>
                Dashboard
            </IgbNavDrawerItem>

            <IgbNavDrawerItem Active="@IsRoute("/tickets")" @onclick="@(() => GoTo("/tickets"))">
                <IgbIcon slot="icon" name="confirmation_number" collection="material"></IgbIcon>
                Tickets
            </IgbNavDrawerItem>
        </IgbNavDrawer>

        <main class="main-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _navOpen = true;

    private void ToggleNav() => _navOpen = !_navOpen;

    private bool IsRoute(string path)
    {
        var localPath = new Uri(Nav.Uri).LocalPath;
        if (path == "/")
            return localPath == "/" || localPath == "";
        return localPath.Equals(path, StringComparison.OrdinalIgnoreCase)
            || localPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void GoTo(string path) => Nav.NavigateTo(path);
}
